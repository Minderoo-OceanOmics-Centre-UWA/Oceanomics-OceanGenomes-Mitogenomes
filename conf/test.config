/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run . -profile test,<docker/singularity> -stub --outdir <OUTDIR>

    Real (non-stub) execution needs the reference databases that have no default
    (--curated_blast_db, --nt_blast_db, --template_sbt), so this profile is a stub
    smoke test of the wiring, not a data-producing run.

----------------------------------------------------------------------------------------
*/

// The bundled test reads live inside the repository, but nf-schema resolves a relative
// file-path cell in the samplesheet against launchDir, not against the samplesheet. A
// committed relative path would therefore only work when the pipeline is launched from
// the clone root, and the documented invocation (`nextflow run nf-core/...`) is launched
// from anywhere. So absolutise the tracked template into a run-local temp copy. This is
// the same __PROJECT_DIR__ substitution the nf-tests under tests/samplesheet_meta do.
def test_samplesheet = java.io.File.createTempFile('oceangenomes_test_samplesheet', '.csv')
test_samplesheet.deleteOnExit()
test_samplesheet.text = new File("${projectDir}/tests/test_data/samplesheet_test.csv")
        .text.replace('__PROJECT_DIR__', "${projectDir}")

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Two invertebrate HiFi rows carrying the full taxonomy columns, so the run
    // exercises the invertebrate reference-database routing rather than the
    // vertebrate MitoHiFi path.
    input                      = test_samplesheet.toString()

    // GetOrganelle organelle label. No default in nextflow.config, and GETORGANELLE_CONFIG
    // takes it as a plain val, so leaving it null aborts the run at channel construction.
    organelle_type             = 'animal_mt'

    // Everything below needs an external resource this repository cannot ship: the
    // annotation/LCA stage hard-requires --taxonkit_db_dir and --nt_blast_db, ENA prep
    // hard-requires --template_sbt, and the upload/QC modules need Postgres credentials.
    // The test profile therefore covers samplesheet parsing and the assembly wiring; run
    // the annotation stages against the real databases when you need to exercise them.
    skip_mitogenome_annotation = true
    skip_ena_submission_prep   = true
    skip_upload_results        = true
}
