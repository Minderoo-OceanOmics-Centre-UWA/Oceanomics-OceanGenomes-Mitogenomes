/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/oceangenomesmitogenomes Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

//
// Memory hints for attempt-scaled processes (OATK, GETORGANELLE_RESEED,
// GETORGANELLE_FROMREADS). PIPELINE_COMPLETION's onComplete handler (see
// subworkflows/local/utils_nfcore_oceangenomesmitogenomes_pipeline) records,
// per sample, the memory tier a retried task actually succeeded at. Without
// this, -resume restarts that sample's attempt counter at 1, and the attempt
// number salts the task hash, so resume asks for attempt 1's hash -- which
// records a *failure* -- and the default low tier reruns and re-fails before
// climbing back to the tier that worked. (Note the salt is the attempt, not
// the resolved memory: TaskProcessor hashes uniqueId, process name, source,
// container fingerprint, conda env, module, arch, bin dirs, inputs and
// getAttempt. Resource directives are not hashed, so editing cpus/memory/time
// or a retry policy here does NOT invalidate -resume.) Loaded once at
// config-parse time; a missing/empty file is a no-op and falls back to the
// `params.hinted_memory_base_gb * task.attempt` ladder below.
//
def _memory_hints_file = params.outdir ? new File("${params.outdir}/pipeline_info/memory_hints.json") : null
// `def` (a script-local var, not a bare binding) is deliberate: an unqualified
// top-level assignment here gets picked up by Nextflow's config-attribute
// validation, and an *empty* map assigned that way (the common case -- no
// hints recorded yet) is rejected at parse time with "Unknown config
// attribute `memoryHints`" (verified; a populated map did not trigger it,
// which made this easy to miss testing only the happy path). Kept `def`-local
// and passed explicitly into hintedMemory() below instead, since a directive
// closure (unlike a plain method) does correctly capture an enclosing `def`.
def memoryHints = [:]
if (_memory_hints_file && _memory_hints_file.exists()) {
    try {
        memoryHints = new groovy.json.JsonSlurper().parse(_memory_hints_file) as Map
    } catch (Exception e) {
        // `log` isn't bound at config-parse time (ConfigSlurper auto-vivifies
        // it as an empty ConfigObject, so `log.warn(...)` fails with
        // "Unknown method invocation `warn`" -- verified). Use stderr instead.
        System.err.println("WARN: could not parse memory hints file ${_memory_hints_file}: ${e.message} -- ignoring")
    }
}

// Hinted memory (GB) for `sampleId` on `processName`'s first attempt if one
// was recorded from a previous run; otherwise the standard escalating tier.
// `hints` is passed explicitly (rather than read from an enclosing variable)
// because hintedMemory() is a plain method: methods don't participate in
// Groovy closure-capture the way the `memory = { hintedMemory(memoryHints, ...) }`
// call site does, so a method body can't see a sibling top-level `def` directly.
//
// The attempt-1 tier is `params.hinted_memory_base_gb` (64 GB), NOT the 100 GB it
// used to be, because on Setonix the memory request is what gets charged: SU bills
// `max(cpus/128, memory/230) * 128` core-equivalents, so 100 GB costs 55.7 cores
// against the 16 these processes actually ask for. That is why GETORGANELLE_FROMREADS
// was 548.63 of the 20-sample invert panel's 651.26 SU (84%) at 3.14% median CPU and
// 13.02% median memory efficiency. 64 GB charges 35.6 cores, a 36% cut, and is the
// lowest round tier above the 51.9 GB peak RSS observed across those 19 assemblies
// (min 6.9 GB, median ~13 GB). The floor before the cpu request dominates is 28.75 GB
// (16/128 * 230), but the observed peak forbids going there and the retry ladder
// (128, 192 GB) covers outliers. `cpus` is deliberately NOT reduced, and the
// benchmark question that used to be open here is now settled -- see the note above
// the GETORGANELLE withName blocks below. Short version: 16 is a performance
// ceiling, not an untuned default, and the low CPU efficiency is expected.
def hintedMemory(hints, processName, taskAttempt, sampleId) {
    def hint = hints[processName]?.get(sampleId)
    if (taskAttempt == 1 && hint) {
        return (hint as Integer).GB
    }
    return Math.min(230, (params.hinted_memory_base_gb ?: 64) * taskAttempt).GB
}

process {

    // TODO nf-core: Check the defaults for all processes
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    maxRetries    = 2
    errorStrategy = {
        def retries = task.maxRetries ?: 0
        def resource_failure = task.exitStatus == null || task.exitStatus in ((130..145) + 104 + 247)
        // One retry is granted UNCONDITIONALLY, whatever the exit status. That is the
        // lost-sbatch-acknowledgement case: Setonix's slurmctld drops the reply under
        // load, sbatch exits 1, and Nextflow records exitStatus=1 -- sbatch's own code,
        // indistinguishable by exit code from a genuine script failure. Classifying
        // transience by an exit-code allowlist therefore sent it straight to 'ignore' at
        // attempt 1, discarding work that had in fact SUCCEEDED (verified on all 7 such
        // work dirs from NOVA_260909_LA_mitogenomes-3: .command.begin present,
        // .exitcode == 0, complete output set) and leaving the downstream channels
        // unclosed, which stranded every aggregator for 11 days.
        // The retry is collision-free: getAttempt salts the task hash (see the note at
        // the top of this file), so attempt 2 gets a FRESH work dir and cannot clobber
        // the orphan SLURM job the lost ack left running. That is exactly the property
        // pawsey_profile.config's submit.retry.reason override depends on -- do NOT
        // re-enable executor submit retry, which reuses the SAME work dir.
        def budget = resource_failure ? retries : Math.min(1, retries)
        task.attempt <= budget ? 'retry' : 'ignore'
    }
    // A failed sample must not abort a cohort run. Transient failures are retried;
    // deterministic or exhausted failures are reported and left for a later -resume.
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_upload {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        // 45 m, not 30 m: these tasks are 12-25 s of compute, but they contend on the
        // OceanOmics DB and the tail is long. PUSH_QC_VALIDATOR reached 29:01 twice in
        // 30 days against the old 30 m limit, i.e. one slow lock away from a timeout.
        // Walltime is free here -- Setonix bills elapsed time and a memory-driven core
        // count, neither of which the limit affects.
        time   = { 45.m  * task.attempt }
    }
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { Math.min( 24, 8 * task.attempt ).h }
    }
    withLabel:process_high {
        cpus   = 12
        memory = { 72.GB * task.attempt }
        time   = { Math.min( 24, 16 * task.attempt ).h }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    // withLabel:error_ignore {
    //     errorStrategy = 'ignore'
    // }
    // withLabel:error_retry {
    //     errorStrategy = 'retry'
    //     maxRetries    = 2
    // }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
    withName: MITOHIFI_FINDMITOREFERENCE {
        // Retry transient NCBI failures, then leave the affected sample for -resume.
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }
    // DO NOT RAISE `cpus` ON THE TWO GETORGANELLE PROCESSES BELOW.
    //
    // 16 is an empirical performance ceiling, not an untuned default: higher thread
    // counts were measured to make GetOrganelle assemble *worse*, not faster. The
    // low CPU efficiency these jobs report (~3-4% against the billed core count) is
    // the expected consequence of that cap and is NOT evidence of waste.
    //
    // Nor should `cpus` be lowered to save SU: it is not what you are charged for.
    // Setonix bills max(cpus, memory/230 * 256), so the `memory` directive alone
    // sets the billed core count -- 64 GB buys 72 cores regardless of this 16.
    //
    // `memory` is therefore set independently, via hintedMemory() above, and cannot
    // be derived from `cpus`: 16 cpus on its own would grant only 16/128 * 230 =
    // 28.75 GB, which is below the median peak RSS of the vertebrate workload
    // (38.4 GB) and so would OOM most assemblies outright.
    withName:GETORGANELLE_FROMREADS {
        cpus   = 16
        memory = { hintedMemory(memoryHints, 'GETORGANELLE_FROMREADS', task.attempt, task.tag) }
        time   = { Math.min( 24, 16 * task.attempt ).h }
    }
    withName:GETORGANELLE_RESEED {
        cpus   = 16
        memory = { hintedMemory(memoryHints, 'GETORGANELLE_RESEED', task.attempt, task.tag) }
        time   = { Math.min( 24, 16 * task.attempt ).h }
        // Retry policy intentionally inherited from the global default above
        // (maxRetries = 2, transient = 130..145 + 104 + 247), matching
        // GETORGANELLE_FROMREADS. The narrower override this replaced treated
        // only 137 (OOM) as transient, so a walltime kill (140) was ignored on
        // attempt 1 -- that is how OG28.ilmn.231024 lost its reseed assembly in
        // batch-02. 137 stays covered because it sits inside 130..145.
    }
    withName:OATK {
        // Reference-free HiFi fallback; overrides the module's process_medium label.
        // OG109 exhausted the former 24 GB allocation (23.6 GB peak RSS). Retry
        // an OOM/resource kill or a missing Slurm exit status, escalating memory
        // only on subsequent attempts.
        cpus   = 8
        memory = { hintedMemory(memoryHints, 'OATK', task.attempt, task.tag) }
        time   = { Math.min( 24, 8 * task.attempt ).h }
        // Retry policy intentionally inherited from the global default above
        // (maxRetries = 2, transient = 130..145 + 104 + 247), matching
        // GETORGANELLE_RESEED. The narrower override this replaced treated only
        // 137 (OOM) as transient, so a walltime kill (140/143) fell through to
        // 'ignore' instead of retrying. 137 stays covered: it sits inside
        // 130..145.
    }
    withName:MITOGENOME_COVERAGE {
        // minimap2 against a ~33 kb doubled index needs almost no memory; the cost
        // is streaming the whole library past it, so this is CPU/IO bound rather
        // than memory bound and does not need process_medium's 36 GB ladder.
        // Depth is a measurement, never a reason to fail a sample, so a task that
        // cannot be retried is ignored -- the empty-placeholder join downstream
        // keeps the SQL upload and the summary intact without it.
        // Sized from measurement, not from the 12/16 GB guess this replaced:
        // the Aug-25 batch-19 trace for OG2288 records %cpu=2228 (2.2 cores) and
        // peak_rss=484604 (473 MB). The pipeline is `minimap2 -t N | awk | python`,
        // so threads past the single-threaded awk consumer cannot be used. Memory
        // is the directive that actually shrinks the Slurm allocation here, since
        // the granted core count is driven up by the memory request.
        cpus   = 4
        memory = { 4.GB * task.attempt }
        time   = { Math.min( 24, 8 * task.attempt ).h }
        // Each task streams an entire WGS library past a 33 kb index, so a batch
        // is bounded by Lustre read bandwidth and by that single awk, not by
        // cores. Batch-19 launched 13 at once and each decayed ~15x (476k -> 22k
        // reads/s, minimap2 CPU multiplier 2.4x -> 0.70x); the same samples on the
        // same nodes at 6 concurrent held 290-430k reads/s to completion.
        maxForks = params.mitogenome_depth_max_forks
        // Retry policy intentionally inherited from the global default above
        // (maxRetries = 2, transient = 130..145 + 104 + 247), matching
        // GETORGANELLE_RESEED. The narrower override this replaced treated only
        // 137 (OOM) as transient, so a walltime kill (140/143) fell through to
        // 'ignore' instead of retrying. 137 stays covered: it sits inside
        // 130..145.
    }
    withName:LCA {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 30.m * task.attempt }
        // Retry policy intentionally inherited from the global default above
        // (maxRetries = 2, transient = 130..145 + 104 + 247), matching
        // GETORGANELLE_RESEED. The narrower override this replaced treated only
        // 137 (OOM) as transient, so a walltime kill (140/143) fell through to
        // 'ignore' instead of retrying. 137 stays covered: it sits inside
        // 130..145.
    }

    withName:SPECIES_VALIDATION {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 30.m * task.attempt }
        // Retry policy intentionally inherited from the global default above
        // (maxRetries = 2, transient = 130..145 + 104 + 247), matching
        // GETORGANELLE_RESEED. The narrower override this replaced treated only
        // 137 (OOM) as transient, so a walltime kill (140/143) fell through to
        // 'ignore' instead of retrying. 137 stays covered: it sits inside
        // 130..145.
    }

    // Right-sizing for tasks that carry process_medium (36 GB -> 42 billed cores on
    // Setonix, since the billed core count is memory-driven: ReqMem/230 * 256) but
    // never come close to using it. Figures below are 30 days of sacct (MaxRSS from
    // the .batch step, elapsed from the job step).
    //
    //   EMMA                   n=1857  mean 36 s   max RSS 1.7 GB
    //   CORAL_ANNOTATION_FIX   n=301   mean 16 s   max RSS <0.2 GB
    //   GEN_FILES_TABLE2ASN    n=2211  mean 18 s   max RSS <0.2 GB
    //   BUILD_SOURCE_MODIFIERS n=1675  mean 18 s   max RSS <0.2 GB
    //   MITOS2                 n=400   mean 14 m   max RSS 3.4 GB
    //
    // Overrides live here rather than on the modules' `label` lines so the nf-core
    // module files stay unmodified for lint/sync.
    withName: /CORAL_ANNOTATION_FIX|GEN_FILES_TABLE2ASN|BUILD_SOURCE_MODIFIERS/ {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName:EMMA {
        cpus   = 2
        memory = { 12.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName:MITOS2 {
        cpus   = 2
        memory = { 12.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    // BLAST_BLASTN is the second-largest small-task consumer (n=7292, 40,268
    // core-hours). Mean RSS is 5.2 GB but max hits the 36 GB ceiling, so this keeps
    // a real retry ladder (12/24/36 GB) instead of a flat cut.
    //
    // cpus raised 4 -> 12 for the core_nt switch. This is FREE: Setonix bills
    // max(cpus, memory/230*256) cores, which at 12 GB is already max(4, 13) = 13, so
    // the first 13 cpus cost nothing extra and the memory ladder still dominates
    // billing at every attempt. Time raised 2.h -> 4.h because a single 1.5 kb query
    // against core_nt took ~56 min against a cold Lustre page cache (and 37-66 s once
    // warm) -- the first few tasks of a cohort must not time out warming it.
    withName:BLAST_BLASTN {
        cpus   = 12
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: /DOWNLOAD_BLAST_DB|DOWNLOAD_TAXONKIT_DB|PREPARE_LCA_DATABASES/ {
        // These singleton tasks provide shared prerequisites for the entire cohort.
        // Retry infrastructure/resource failures, but terminate rather than allowing
        // hundreds of samples to continue without a valid database.
        maxRetries = 2
        errorStrategy = {
            def transient_failure = task.exitStatus == null || task.exitStatus in ((130..145) + 104 + 247)
            transient_failure && task.attempt <= task.maxRetries ? 'retry' : 'terminate'
        }
    }
    withName:PREPARE_LCA_DATABASES {
        // Always revalidate the external persistent cache; valid files make this
        // cheap, while a deleted/corrupt cache must never be hidden by -resume.
        cache = false
    }
}
