config {
    // location for all nf-test tests
    testsDir "."

    // nf-test directory including temporary files for each test
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"

    // location of an optional nextflow.config file specific for executing tests
    configFile "tests/nextflow.config"

    // ignore tests coming from the nf-core/modules repo
    ignore 'modules/nf-core/**/tests/*', 'subworkflows/nf-core/**/tests/*'

    // Run all tests with these profiles from the main nextflow.config.
    //
    // A CONTAINER ENGINE has to be in here. Almost every module in this repo declares
    // a container it genuinely needs: without an engine the tools are simply absent,
    // and the failures do not say so. They surface as a wrong verdict from a script
    // that degraded gracefully ("could not parse reference: No module named 'Bio'"),
    // a versions.yml recording the HOST python instead of the container's so its
    // snapshot md5 no longer matches, or a NullPointerException on an output the
    // process never produced.
    //
    // The "test" profile is deliberately NOT in here. It is the smoke-test run profile:
    // it swaps in its own samplesheet and sets skip_upload_results, skip_ena_submission_prep
    // and skip_mitogenome_annotation, which silently overrode the params of every other
    // test (a test of the upload default could never see uploads on). Only
    // tests/default.nf.test asks for it. Resource caps for all tests live in
    // tests/nextflow.config.
    //
    // Overridable for CI or a docker machine: NFT_PROFILE=docker nf-test test ...
    profile System.getenv("NFT_PROFILE") ?: "singularity"

    // list of filenames or patterns that should be trigger a full test run
    triggers 'nextflow.config', 'nf-test.config', 'conf/test.config', 'tests/nextflow.config', 'tests/.nftignore'

    // load the necessary plugins
    plugins {
        load "nft-utils@0.0.3"
    }
}
