config {
    // location for all nf-test tests
    testsDir "."

    // nf-test directory including temporary files for each test
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"

    // location of an optional nextflow.config file specific for executing tests
    configFile "tests/nextflow.config"

    // ignore tests coming from the nf-core/modules repo
    ignore 'modules/nf-core/**/tests/*', 'subworkflows/nf-core/**/tests/*'

    // Run all tests with these profiles from the main nextflow.config.
    //
    // A CONTAINER ENGINE has to be in here. conf/test.config documents the pipeline
    // as "-profile test,<docker/singularity>", and almost every module in this repo
    // declares a container it genuinely needs: with "test" alone the tools are simply
    // absent, and the failures do not say so. They surface as a wrong verdict from a
    // script that degraded gracefully ("could not parse reference: No module named
    // 'Bio'"), a versions.yml recording the HOST python instead of the container's so
    // its snapshot md5 no longer matches, or a NullPointerException on an output the
    // process never produced. Twelve of forty local module tests failed that way, and
    // eleven of them pass unchanged once an engine is selected.
    //
    // Overridable for CI or a docker machine: NFT_PROFILE=test,docker nf-test test ...
    profile System.getenv("NFT_PROFILE") ?: "test,singularity"

    // list of filenames or patterns that should be trigger a full test run
    triggers 'nextflow.config', 'nf-test.config', 'conf/test.config', 'tests/nextflow.config', 'tests/.nftignore'

    // load the necessary plugins
    plugins {
        load "nft-utils@0.0.3"
    }
}
