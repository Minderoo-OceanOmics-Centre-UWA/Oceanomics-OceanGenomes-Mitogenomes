# Only the files the pipeline actually reads are tracked, because these are
# plain git blobs (no LFS) and every rebuild rewrites them into history.
#
#   <group>_mito_refdb.fasta        GetOrganelle reseed seed (-s)          -> tracked
#   <group>_mito_refdb.label.fasta  GetOrganelle label database (--genes)  -> tracked
#   <group>_mito_refdb.manifest.tsv provenance for the above               -> tracked
#   <group>_mito_refdb.gb           canonical GenBank, 85 MB across the
#                                   groups and read only for anthozoa by
#                                   SELECT_CORAL_REFERENCE                 -> anthozoa only
#   <group>_mito_refdb.nucl.*       BLAST db, rebuilt on demand            -> never tracked
#
# Regenerate any untracked file with
#   bin/build_invert_reference_db.py --group <group> --email <you>
*_mito_refdb.gb
!anthozoa/anthozoa_mito_refdb.gb
*_mito_refdb.nucl.*
