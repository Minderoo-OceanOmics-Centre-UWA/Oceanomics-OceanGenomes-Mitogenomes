nextflow_process {

    name "Test Process ROTATE_ORIGIN"
    script "../main.nf"
    process "ROTATE_ORIGIN"

    tag "modules"
    tag "modules_local"
    tag "rotate_origin"

    // cox1_ref is per-sample (not a broadcast value channel) so each phylum group
    // can be rotated against its own curated cox1 anchor panel -- this pins that
    // 3-element tuple input, one process call per phylum's panel.

    test("mollusca sample rotates against the mollusca cox1 panel") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test_mollusca' ],
                    file("${projectDir}/modules/local/select_reference_db/tests/data/query.fa", checkIfExists: true),
                    file("${projectDir}/assets/panels/cox1/mollusca.faa", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.fasta[0][1] ==~ ".*/rotated/query.fa" },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    // A linear contig's ends are assembly breaks: rotating it glues them into a
    // junction that does not exist (NOVA_260909_LA OG3043 was rotated 1300 bp).
    test("linear sample is written through unrotated") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test_linear', circular:false ],
                    file("${projectDir}/modules/local/select_reference_db/tests/data/query.fa", checkIfExists: true),
                    file("${projectDir}/assets/panels/cox1/mollusca.faa", checkIfExists: true)
                ])
                """
            }
        }

        then {
            def seqOf = { f -> f.readLines().findAll { !it.startsWith('>') }.join('').trim() }
            def input = file("${projectDir}/modules/local/select_reference_db/tests/data/query.fa")
            assertAll(
                { assert process.success },
                { assert seqOf(path(process.out.fasta[0][1])) == seqOf(input) },
                { assert path(process.out.tool_params[0][1]).text.contains('--linear') }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test_stub' ],
                    file("${projectDir}/modules/local/select_reference_db/tests/data/query.fa", checkIfExists: true),
                    file("${projectDir}/assets/panels/cox1/arthropoda.faa", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
