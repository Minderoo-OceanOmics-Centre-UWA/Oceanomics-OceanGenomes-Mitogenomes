// Run the ranking script directly rather than in the MitoHiFi container: these tests are
// about the DECISION the script reaches, not about minimap2. Locally minimap2 is simply
// absent, score_candidate swallows the OSError and returns zero for every candidate, and
// that is precisely the state under test -- it is what OG56's five candidates produced in
// mitogenomes-missing-audit-6, from a run where minimap2 was present.
process.executor = 'local'
process.container = null
process.beforeScript = "export PATH=${projectDir}/bin:\$PATH"
