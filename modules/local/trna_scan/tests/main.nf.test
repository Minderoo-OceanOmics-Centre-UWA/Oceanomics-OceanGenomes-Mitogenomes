nextflow_process {

    name "Test Process TRNA_SCAN"
    script "../main.nf"
    process "TRNA_SCAN"

    tag "modules"
    tag "modules_local"
    tag "trna_scan"

    test("scans a bundle FASTA and emits a table") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', mt_assembly_prefix:'test', genetic_code:2 ],
                    file("${projectDir}/modules/local/trna_scan/tests/data/bundle/annotation", checkIfExists: true).listFiles().toList()
                ])
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.tsv[0][1]).exists() },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test_stub', mt_assembly_prefix:'test_stub', genetic_code:2 ],
                    file("${projectDir}/modules/local/trna_scan/tests/data/bundle/annotation", checkIfExists: true).listFiles().toList()
                ])
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
