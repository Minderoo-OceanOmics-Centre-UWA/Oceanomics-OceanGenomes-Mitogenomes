cleanup = false
resume = true

singularity {
    enabled = true
    autoMounts = true
    // Must live on a project whose GROUP quota has headroom: the /software quota is
    // charged by group, so an image written here with group pawsey0964 counts against
    // pawsey0964 regardless of the path. pawsey0964 is at its quota, and a write that
    // exceeds it fails only at close(), so singularity/curl leave a 0-byte image behind
    // and the pull "succeeds" silently. Keep this dir setgid pawsey1348 (chmod 2775).
    cacheDir = "/software/projects/pawsey1348/singularity/nextflow_cache"
    envWhitelist = 'SINGULARITY_BINDPATH, SINGULARITYENV_LD_LIBRARY_PATH, SINGULARITYENV_LD_PRELOAD'
}

process {
    queue = { task.memory <= 230.GB ? 'work' : 'highmem' }
    beforeScript = '''
        module load singularity/4.1.0-nompi
    '''
    cache = 'lenient'
    stageInMode = 'symlink'
    module = 'singularity/4.1.0-nompi'
    executor = 'slurm'
    clusterOptions = {
        def account = '-A pawsey1348'
        def processName = task.process.tokenize(':').last()
        def finalName = task.tag ? "${task.tag}.${processName}" : processName
        def jobName = "--job-name=${finalName.replaceAll('[^a-zA-Z0-9._-]', '_').take(64)}"
        return "${account} ${jobName}"
    }
}

executor {
    queueSize=1000

    // Setonix's slurmctld intermittently drops the sbatch reply under load:
    //   sbatch: error: Batch job submission failed: Socket timed out on send/recv operation
    // The job IS accepted and queued; only the acknowledgement is lost, so sbatch
    // still exits non-zero. Nextflow's default executor.submit.retry.reason is the
    // literal 'Socket timed out', so it resubmits, producing a SECOND SLURM job for
    // the same task in the SAME work directory. Both run, on different nodes, and
    // whichever loses the race dies on noclobber part-way through the task body,
    // after having already rewritten the winner's outputs.
    //
    // Disable that retry and handle the lost acknowledgement at the process level
    // instead. That retry gets a fresh work directory (getAttempt salts the task
    // hash), so the two attempts cannot collide.
    //
    // NOTE: a lost acknowledgement does NOT surface as a null exit status -- sbatch's
    // own exit code (1) is propagated, and NOVA_260909_LA_mitogenomes-3 recorded all
    // 7 of them as `exit=1 attempt=1`. An earlier version of this comment claimed
    // otherwise, and conf/base.config's errorStrategy was classifying transience by
    // an exit-code allowlist that 1 is not in, so these went straight to 'ignore' on
    // the first attempt: 7 tasks that had actually SUCCEEDED were discarded, their
    // outputs never bound, and the unclosed channels deadlocked the run for 11 days.
    // conf/base.config now grants one retry unconditionally, whatever the exit
    // status, which is what makes disabling the executor-level retry safe.
    submit.retry.reason = '__nextflow_never_retry_submit__'

    // Reduce the slurmctld pressure that causes the dropped replies in the first
    // place. queueSize=1000 above lets Nextflow fire submissions as fast as it can.
    // 5/sec rather than 10/sec: at ~1900 tasks per cohort with pollInterval = '1 min'
    // the submission rate is nowhere near the critical path, so there is no reason to
    // push slurmctld as hard as it will go.
    submitRateLimit = '5/1sec'

    $slurm {
        pollInterval = '1 min'
        queueStatInterval = '5 min'
    }
    $local {
        pollInterval = '2 sec'
    }
}

params {
    max_cpus = 36
    max_time = 24.h
}

env {
    PYTHONNOUSERSITE = 1
}