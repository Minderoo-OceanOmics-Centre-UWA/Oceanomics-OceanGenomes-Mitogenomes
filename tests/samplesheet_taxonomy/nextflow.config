/*
 * Harness config for the --input_dir wiring test.
 *
 * Only the stub bodies run, so nothing here needs the psycopg2 container or a
 * scheduler; the local executor just guarantees nothing reaches Slurm.
 */

process.executor = 'local'

params {
    input = null
    samplesheet_prefix = 'samplesheet'
}
