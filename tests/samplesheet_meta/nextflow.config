/*
 * Harness config for the samplesheet meta-shape test.
 *
 * PREPARE_SAMPLESHEET runs no process when --input is a samplesheet (it is pure
 * operators plus nf-schema), so nothing here needs a container or a scheduler. The local
 * executor is set only so a stray process could never be dispatched to Slurm from a test.
 */

process.executor = 'local'

params {
    input_dir = null
    samplesheet_prefix = 'samplesheet'
}
