/*
 * Local-only harness for the HiFi read-preparation routing test.
 *
 * conf/base.config is deliberately NOT included: its per-label CPU/memory requests are
 * sized for Setonix and would serialise these tiny tasks on a login node, which would
 * mask the very thing the concurrency test asserts.
 */

process.executor = 'local'

executor {
    name = 'local'
    cpus = 8
    memory = '8.GB'
}

// withName, not a bare `process.memory`: the pipeline's own base.config assigns
// CAT_FASTQ 6 GB through `withLabel: process_single`, and a label selector outranks
// the generic block. These tasks concatenate a few hundred bytes.
process {
    time = '10.m'

    withName: 'CAT_FASTQ' {
        cpus = 1
        memory = '256.MB'
        // Hold every concatenation open long enough that a singleton sample provably
        // finishes its downstream work first if -- and only if -- the two routes stream
        // independently. Applied as beforeScript so the nf-core module stays untouched.
        beforeScript = { params.cat_fastq_delay ? "sleep ${params.cat_fastq_delay}" : '' }
    }

    withName: 'DOWNSTREAM_MARKER' {
        cpus = 1
        memory = '256.MB'
    }

    withName: 'REFERENCE_STUB' {
        cpus = 1
        memory = '256.MB'
    }
}

params {
    cat_fastq_delay = 0
    // Meta key the reference stub drops from the meta it hands back, standing in for a
    // resumed run whose cached meta has a different key set. null = hand it back intact.
    drop_meta_key = null
    samples = []
}
