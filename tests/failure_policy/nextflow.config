// conf/base.config reads these at parse time, so they must exist before the include or
// every test in this suite dies with "Unknown config attribute `params.<name>`" before the
// workflow even runs. Keep this list in step with `grep -o 'params\.[a-z_]*' conf/base.config`
// -- this is the same footgun documented in tests/assembly_routing/nextflow.config, and it
// is what had been failing every SAMPLE_POLICY test here once they started executing.
params.outdir = 'results'
params.mitogenome_depth_max_forks = 4

includeConfig '../../conf/base.config'

params.scenario = 'mixed'

// Local executor: exit codes are faithful and no SLURM is needed to exercise the policy.
process.executor = 'local'
