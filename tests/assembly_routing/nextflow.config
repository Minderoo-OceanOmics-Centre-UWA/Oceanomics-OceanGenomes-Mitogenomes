// conf/base.config reads params.outdir at parse time, so it must exist before the include
// or every test in this file dies with "Unknown config attribute `params.outdir`" before the
// workflow even runs.
params.outdir = 'results'

includeConfig '../../conf/base.config'

params.scenario = 'success'
params.mitohifi_container = 'unused-in-local-test'
params.ncbi_api_key = null

process.executor = 'local'
process.beforeScript = "export PATH=${projectDir}/bin:\$PATH"

process {
    withName: 'MITOHIFI_FINDMITOREFERENCE' {
        ext.args = { "--test-attempt ${task.attempt}" }
    }
}
