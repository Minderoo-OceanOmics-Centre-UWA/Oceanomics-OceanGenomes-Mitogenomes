// conf/base.config reads these at parse time, so they must exist before the include or
// every test in this file dies with "Unknown config attribute `params.<name>`" before the
// workflow even runs. Keep this list in step with `grep -o 'params\.[a-z_]*' conf/base.config`:
// adding a parse-time param there without adding it here breaks the whole suite at once,
// which is how mitogenome_depth_max_forks silently took out all five oatk-fallback tests.
params.outdir = 'results'
params.mitogenome_depth_max_forks = 4

includeConfig '../../conf/base.config'

params.scenario = 'success'
params.mitohifi_container = 'unused-in-local-test'
params.ncbi_api_key = null
params.reseed_length_tolerance = 1.5
// The prefer_reseed fixtures are small synthetic assemblies (2,974-14,736 bp), so the
// floor sits below every one of them and above the 155 bp OG3000 case that tests it.
params.min_circular_mito_bp = 1000

process.executor = 'local'
process.beforeScript = "export PATH=${projectDir}/bin:\$PATH"

process {
    withName: 'MITOHIFI_FINDMITOREFERENCE' {
        ext.args = { "--test-attempt ${task.attempt}" }
    }
}
