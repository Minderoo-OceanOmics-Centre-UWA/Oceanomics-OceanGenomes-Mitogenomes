// conf/base.config reads these at parse time; see tests/assembly_routing/nextflow.config.
params.outdir = 'results'
params.mitogenome_depth_max_forks = 4

includeConfig '../../conf/base.config'

process.executor = 'local'

process {
    withName: 'BLAST_BLASTN' {
        cpus   = 1
        memory = 1.GB
        // ext.args is set per-test via the harness, not here: a withName selector in an
        // nf-test `config` block is unreliable for a module invoked from a wrapper.
        ext.args = { params.blast_ext_args ?: '' }
        // The preflight test asserts the task fails, so it must not be retried or
        // ignored by conf/base.config's cohort-safety policy.
        errorStrategy = 'terminate'
        maxRetries    = 0
    }
}

params.blast_ext_args = ''
