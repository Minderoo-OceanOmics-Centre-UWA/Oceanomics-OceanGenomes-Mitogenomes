/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/oceangenomesmitogenomes'
}

// Same caps as conf/test.config, for every test. They used to arrive only because
// nf-test.config forced the "test" profile onto every test, which also forced that
// profile's params; see nf-test.config.
process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners
